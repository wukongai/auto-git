{
  "permissions": {
    "allow": [
      "Bash(git status --short)",
      "Bash(git status --porcelain)",
      "Bash(git diff --stat)",
      "Bash(git branch --show-current)",
      "Bash(git remote -v)",
      "Bash(git rev-parse --show-toplevel)",
      "Bash(pwd)",
      "Bash(python3 -m pytest:*)",
      "Bash(ruff check:*)",
      "Bash(python3 -m compileall:*)",
      "Read(./**)"
    ],
    "deny": [
      "Bash(git add -A:*)",
      "Bash(git add .:*)",
      "Bash(git add --all:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(prisma db push:*)",
      "Bash(npx prisma db push:*)",
      "Bash(prisma migrate reset:*)",
      "Bash(npx prisma migrate reset:*)",
      "Write(.env)",
      "Write(.env.local)",
      "Write(.env.production)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(.env.production)"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/protect-env.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/protect-dangerous-rm.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
